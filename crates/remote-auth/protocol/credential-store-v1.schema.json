{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devicerail.dev/schema/credential-store-v1.json",
  "title": "DeviceRail credential store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "principals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId", "keyId", "secretBase64", "permissions"],
        "properties": {
          "principalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "keyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "secretBase64": {
            "type": "string",
            "minLength": 43,
            "maxLength": 86,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["read", "control", "admin"] }
          }
        }
      }
    }
  }
}
