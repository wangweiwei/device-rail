{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devicerail.dev/schema/audit-record-v1.json",
  "title": "DeviceRail audit record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sequence", "atMs", "connectionId", "principalId",
    "stage", "method", "requiredPermission", "decision", "outcome", "errorCode",
    "previousHash", "entryHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "atMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "connectionId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
    "principalId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stage": { "const": "securityAdmission" },
    "method": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9._]*$" },
    "requiredPermission": { "enum": ["read", "control", "admin", null] },
    "decision": { "enum": ["allowed", "denied"] },
    "outcome": { "enum": ["succeeded", "failed"] },
    "errorCode": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "previousHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
