{
  "$defs": {
    "EventSequence": {
      "description": "A one-based sequence number within one session.\n\nThe wire value is capped at JavaScript's maximum safe integer so generated\nclients can sort and resume event streams without losing precision.",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "EventsListMethodSchema": {
      "enum": [
        "events.list"
      ],
      "type": "string"
    },
    "EventsListParams": {
      "additionalProperties": false,
      "description": "Optional parameters accepted by `events.list`.",
      "properties": {
        "afterSequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventSequence"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "format": "uint32",
          "maximum": 1000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "sessionId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "JsonRpcVersion": {
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "RpcIdSchema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ]
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:events-list-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/RpcIdSchema"
    },
    "jsonrpc": {
      "$ref": "#/$defs/JsonRpcVersion"
    },
    "method": {
      "$ref": "#/$defs/EventsListMethodSchema"
    },
    "params": {
      "$ref": "#/$defs/EventsListParams"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "title": "EventsListRequest",
  "type": "object"
}
