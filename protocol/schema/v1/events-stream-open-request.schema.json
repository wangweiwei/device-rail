{
  "$defs": {
    "EventStreamOriginPolicy": {
      "description": "Browser Origin policy bound to a single-use stream capability.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Node and other non-browser clients must omit Origin entirely.",
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Browser clients must send exactly this Origin value.",
          "properties": {
            "kind": {
              "const": "exact",
              "type": "string"
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "origin"
          ],
          "type": "object"
        }
      ]
    },
    "EventsStreamOpenMethodSchema": {
      "enum": [
        "events.stream.open"
      ],
      "type": "string"
    },
    "EventsStreamOpenParams": {
      "additionalProperties": false,
      "properties": {
        "originPolicy": {
          "$ref": "#/$defs/EventStreamOriginPolicy"
        },
        "sessionId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "originPolicy"
      ],
      "type": "object"
    },
    "JsonRpcVersion": {
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "RpcIdSchema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ]
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:events-stream-open-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/RpcIdSchema"
    },
    "jsonrpc": {
      "$ref": "#/$defs/JsonRpcVersion"
    },
    "method": {
      "$ref": "#/$defs/EventsStreamOpenMethodSchema"
    },
    "params": {
      "$ref": "#/$defs/EventsStreamOpenParams"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "title": "EventsStreamOpenRequest",
  "type": "object"
}
