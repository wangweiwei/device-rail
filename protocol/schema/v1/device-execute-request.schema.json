      "$ref": "#/$defs/DeviceExecuteMethodSchema"
    },
    "params": {
      "$ref": "#/$defs/DeviceExecuteParams"
    },
    "timeoutMs": {
      "$ref": "#/$defs/RequestTimeoutMs"
    }
  },
  "required": [
