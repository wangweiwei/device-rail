{
  "$defs": {
    "EventStreamEndpoint": {
      "description": "A short-lived bearer URL. Debug intentionally never exposes its contents.",
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "EventStreamEpoch": {
      "description": "Identifies one daemon process lifetime. A cursor from another epoch must\nnever be accepted as a resumable position.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:events-stream-open-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "endpoint": {
      "$ref": "#/$defs/EventStreamEndpoint"
    },
    "expiresAtMs": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "streamEpoch": {
      "$ref": "#/$defs/EventStreamEpoch"
    }
  },
  "required": [
    "endpoint",
    "streamEpoch",
    "expiresAtMs"
  ],
  "title": "EventsStreamOpenResult",
  "type": "object"
}
