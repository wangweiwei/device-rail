{
  "$defs": {
    "TextMatchMode": {
      "enum": [
        "exact",
        "contains"
      ],
      "type": "string"
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:text-match",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caseSensitive": {
      "type": "boolean"
    },
    "mode": {
      "$ref": "#/$defs/TextMatchMode",
      "default": "exact"
    },
    "value": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "value"
  ],
  "title": "TextMatch",
  "type": "object"
}
