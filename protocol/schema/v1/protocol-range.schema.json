{
  "$id": "urn:devicerail:schema:protocol:v1:protocol-range",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A contiguous minor-version range within one protocol major version.",
  "properties": {
    "major": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "maxMinor": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "minMinor": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "major",
    "minMinor",
    "maxMinor"
  ],
  "title": "ProtocolRange",
  "type": "object"
}
