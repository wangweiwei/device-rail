{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devicerail.dev/schema/release-manifest-v1.json",
  "title": "DeviceRail portable release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "platform",
    "architecture",
    "distribution",
    "releaseStatus",
    "sourceDateEpoch",
    "signing",
    "warning",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "const": "DeviceRail"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "platform": {
      "enum": ["linux", "macos", "windows"]
    },
    "architecture": {
      "enum": ["x86_64", "aarch64"]
    },
    "distribution": {
      "const": "portable-installer-archive"
    },
    "releaseStatus": {
      "enum": ["signed", "unsigned-test-only"]
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4354819199
    },
    "warning": {
      "type": ["string", "null"]
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "payloadScheme",
        "payloadSignedFiles",
        "archiveScheme",
        "archiveSignatureRequired"
      ],
      "properties": {
        "status": {
          "enum": ["signed", "unsigned-test-only"]
        },
        "payloadScheme": {
          "enum": ["none", "apple-codesign", "authenticode", "cosign-key"]
        },
        "payloadSignedFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "archiveScheme": {
          "enum": ["none", "cosign-key"]
        },
        "archiveSignatureRequired": {
          "type": "boolean"
        },
        "archivePublicKeySha256": {
          "$ref": "#/$defs/sha256"
        },
        "payloadPublicKeySha256": {
          "$ref": "#/$defs/sha256"
        },
        "macosTeamId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$"
        },
        "macosDesignatedRequirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[ -~]+$"
        },
        "macosSigningIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[ -~]+$"
        },
        "windowsPublisherSubject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "windowsPublisherSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "mode"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          },
          "mode": {
            "enum": ["0644", "0755"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseStatus": { "const": "signed" }
        },
        "required": ["releaseStatus"]
      },
      "then": {
        "properties": {
          "signing": {
            "required": ["archivePublicKeySha256"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": { "const": "linux" }
        },
        "required": ["platform"]
      },
      "then": {
        "properties": {
          "sourceDateEpoch": { "maximum": 4294967295 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": { "const": "linux" },
          "releaseStatus": { "const": "signed" }
        },
        "required": ["platform", "releaseStatus"]
      },
      "then": {
        "properties": {
          "signing": {
            "required": ["payloadPublicKeySha256"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": { "const": "macos" },
          "releaseStatus": { "const": "signed" }
        },
        "required": ["platform", "releaseStatus"]
      },
      "then": {
        "properties": {
          "signing": {
            "required": [
              "macosTeamId",
              "macosDesignatedRequirement",
              "macosSigningIdentity"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": { "const": "windows" },
          "releaseStatus": { "const": "signed" }
        },
        "required": ["platform", "releaseStatus"]
      },
      "then": {
        "properties": {
          "signing": {
            "required": [
              "windowsPublisherSubject",
              "windowsPublisherSha256"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
