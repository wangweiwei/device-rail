{
  "$defs": {
    "UiRect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "width": {
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:ui-node",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One node in the normalized preorder list. Unknown platform values remain\n`null`; Drivers must not manufacture optimistic enabled/hittable states.",
  "properties": {
    "bounds": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiRect"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hittable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "identifier": {
      "maxLength": 4096,
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "maxLength": 65536,
      "type": [
        "string",
        "null"
      ]
    },
    "parentStableNodeId": {
      "maxLength": 4096,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "stableNodeId": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "text": {
      "maxLength": 65536,
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "maxLength": 65536,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "stableNodeId",
    "role"
  ],
  "title": "UiNode",
  "type": "object"
}
