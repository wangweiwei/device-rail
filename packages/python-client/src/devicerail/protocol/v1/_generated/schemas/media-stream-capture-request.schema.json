{
  "$defs": {
    "EventSequence": {
      "description": "A one-based sequence number within one session.\n\nThe wire value is capped at JavaScript's maximum safe integer so generated\nclients can sort and resume event streams without losing precision.",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "JsonRpcVersion": {
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "MediaStreamCaptureMethodSchema": {
      "enum": [
        "media.stream.capture"
      ],
      "type": "string"
    },
    "MediaStreamCaptureParams": {
      "additionalProperties": false,
      "description": "Parameters accepted by `media.stream.capture`.",
      "properties": {
        "durationMs": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "frameIndex": {
          "$ref": "#/$defs/EventSequence",
          "description": "Caller-declared one-based frame index. Retrying the same accepted index\nis idempotent; advancing it is the caller's acknowledgement boundary."
        },
        "streamId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "frameIndex"
      ],
      "type": "object"
    },
    "RequestTimeoutMs": {
      "description": "A positive timeout in milliseconds that is safe to represent as a JSON\nnumber in every supported client language.",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "RpcIdSchema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ]
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:media-stream-capture-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/RpcIdSchema"
    },
    "jsonrpc": {
      "$ref": "#/$defs/JsonRpcVersion"
    },
    "method": {
      "$ref": "#/$defs/MediaStreamCaptureMethodSchema"
    },
    "params": {
      "$ref": "#/$defs/MediaStreamCaptureParams"
    },
    "timeoutMs": {
      "$ref": "#/$defs/RequestTimeoutMs"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "title": "MediaStreamCaptureRequest",
  "type": "object"
}
