{
  "$defs": {
    "AssetRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "mediaType",
        "uri"
      ],
      "type": "object"
    },
    "VerdictStatus": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:verdict",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "maxItems": 64,
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/VerdictStatus"
    },
    "summary": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary"
  ],
  "title": "Verdict",
  "type": "object"
}
