    "DeviceInfo": {
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "osVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        }
      },
      "required": [
        "id",
        "name",
        "platform",
        "connected"
      ],
      "type": "object"
    },
    "Platform": {
