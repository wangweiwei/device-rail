  "$id": "urn:devicerail:schema:protocol:v1:device-select-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result returned by `device.select`.",
  "properties": {
    "device": {
      "$ref": "#/$defs/DeviceInfo"
    }
  },
  "required": [
    "device"
  ],
  "title": "DeviceSelectResult",
  "type": "object"
}
