{
  "$defs": {
    "AssetRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "mediaType",
        "uri"
      ],
      "type": "object"
    },
    "JsonRpcVersion": {
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "RpcIdSchema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "Verdict": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "maxItems": 64,
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/VerdictStatus"
        },
        "summary": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "type": "object"
    },
    "VerdictRecordMethodSchema": {
      "enum": [
        "verdict.record"
      ],
      "type": "string"
    },
    "VerdictRecordParams": {
      "additionalProperties": false,
      "description": "Parameters accepted by `verdict.record`.\n\nDeviceRail persists this caller-supplied Verdict; it does not infer or\nupgrade the verdict status.",
      "properties": {
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "verdict"
      ],
      "type": "object"
    },
    "VerdictStatus": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:verdict-record-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/RpcIdSchema"
    },
    "jsonrpc": {
      "$ref": "#/$defs/JsonRpcVersion"
    },
    "method": {
      "$ref": "#/$defs/VerdictRecordMethodSchema"
    },
    "params": {
      "$ref": "#/$defs/VerdictRecordParams"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "title": "VerdictRecordRequest",
  "type": "object"
}
