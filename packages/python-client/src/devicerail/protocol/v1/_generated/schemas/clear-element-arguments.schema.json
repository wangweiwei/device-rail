{
  "$defs": {
    "ElementSelector": {
      "additionalProperties": false,
      "description": "Cross-channel selector. Native contexts use accessibility fields; web\ncontexts may additionally use CSS. Context selection never carries a stale\ndocument epoch; resolved node references always carry the full context.",
      "properties": {
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiContextSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "css": {
          "maxLength": 65536,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "maxLength": 4096,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "maxLength": 65536,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextMatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "maxLength": 65536,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ElementTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "selector",
              "type": "string"
            },
            "selector": {
              "$ref": "#/$defs/ElementSelector"
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "node",
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/UiNodeRef"
            }
          },
          "required": [
            "kind",
            "node"
          ],
          "type": "object"
        }
      ]
    },
    "TextMatch": {
      "additionalProperties": false,
      "properties": {
        "caseSensitive": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/TextMatchMode",
          "default": "exact"
        },
        "value": {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "TextMatchMode": {
      "enum": [
        "exact",
        "contains"
      ],
      "type": "string"
    },
    "UiContextKind": {
      "enum": [
        "native",
        "web"
      ],
      "type": "string"
    },
    "UiContextRef": {
      "additionalProperties": false,
      "description": "Full identity of one native accessibility or web-document context.\n`documentEpoch` is required for both channels and changes after reconnect,\nnavigation, or any replacement that invalidates prior node references.",
      "properties": {
        "contextId": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "contextKind": {
          "$ref": "#/$defs/UiContextKind"
        },
        "documentEpoch": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "contextKind",
        "contextId",
        "documentEpoch"
      ],
      "type": "object"
    },
    "UiContextSelector": {
      "additionalProperties": false,
      "description": "Selects a current context without pretending to own its document epoch.",
      "properties": {
        "contextId": {
          "maxLength": 4096,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "contextKind": {
          "$ref": "#/$defs/UiContextKind"
        }
      },
      "required": [
        "contextKind"
      ],
      "type": "object"
    },
    "UiNodeRef": {
      "additionalProperties": false,
      "description": "Durable reference to one node in one observed UI Tree.",
      "properties": {
        "context": {
          "$ref": "#/$defs/UiContextRef"
        },
        "observationId": {
          "format": "uuid",
          "type": "string"
        },
        "stableNodeId": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "observationId",
        "context",
        "stableNodeId"
      ],
      "type": "object"
    }
  },
  "$id": "urn:devicerail:schema:protocol:v1:clear-element-arguments",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "target": {
      "$ref": "#/$defs/ElementTarget"
    }
  },
  "required": [
    "target"
  ],
  "title": "ClearElementArguments",
  "type": "object"
}
