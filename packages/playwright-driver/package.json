{
  "name": "@devicerail/playwright-driver",
  "version": "0.3.2",
  "description": "Private bounded Playwright bridge for the DeviceRail remote web driver",
  "license": "Apache-2.0",
  "keywords": ["device-automation", "browser-automation", "playwright", "testing"],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/helper.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "test": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "playwright-core": "1.62.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
