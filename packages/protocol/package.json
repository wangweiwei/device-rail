{
  "name": "@devicerail/protocol",
  "version": "0.1.0",
  "description": "Generated TypeScript types for the DeviceRail JSON-RPC device automation protocol",
  "license": "Apache-2.0",
  "keywords": ["device-automation", "json-rpc", "json-schema", "typescript"],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./v1": {
      "types": "./dist/generated/v1/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check && node --test scripts/generator.test.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm run check && pnpm run typecheck",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.package-exports.json"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2"
  }
}
