{
  "name": "@devicerail/live-visualizer-app",
  "version": "0.3.4",
  "description": "Private loopback live session visualizer for DeviceRail",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "test": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@devicerail/client": "workspace:*",
    "@devicerail/live-visualizer": "workspace:*",
    "@devicerail/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
